#!/usr/bin/env sh
set -eu

python -m venv /home/vscode/.venv
/home/vscode/.venv/bin/python -m pip install --upgrade pip
/home/vscode/.venv/bin/python -m pip install -r requirements_test.txt
/home/vscode/.venv/bin/pre-commit install
mkdir -p .ha-dev
printf '%s\n' 'Environment ready. Use scripts/run-ha-dev, pytest, ruff check ., and pre-commit run --all-files.'
